# ===================================================================
# ARQUIVO DE CONFIGURAÇÃO - ASSISTENTE DE VOZ MULTIIDIOMAS
# ===================================================================
#
# INSTRUÇÕES:
# 1. Copie este arquivo e renomeie para: .env
# 2. Substitua os valores de exemplo pelos seus valores reais
# 3. NÃO compartilhe este arquivo publicamente
# 4. Adicione .env ao .gitignore se usar Git
#

# ===================================================================
# CHAVES DE API - ESCOLHA UM PROVEDOR OU USE AMBOS
# ===================================================================

# OpenAI API (para ChatGPT)
# Obtenha em: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-seu-token-aqui

# Groq API (alternativa gratuita)
# Obtenha em: https://console.groq.com/keys
GROQ_API_KEY=gsk-seu-token-aqui

# Google Cloud (opcional, para TTS premium)
# Defina o caminho do arquivo JSON de credenciais
GOOGLE_APPLICATION_CREDENTIALS=/caminho/para/credenciais.json

# ===================================================================
# CONFIGURAÇÕES DE ÁUDIO
# ===================================================================

# Taxa de amostragem (Hz)
# Valores típicos: 16000, 44100, 48000
AUDIO_SAMPLE_RATE=16000

# Número de canais
# 1 = mono, 2 = estéreo
AUDIO_CHANNELS=1

# Duração máxima de gravação (segundos)
AUDIO_MAX_DURATION=30

# Limiar de detecção de silêncio (0-5000)
# Valores maiores = menos sensível
AUDIO_SILENCE_THRESHOLD=1000

# ===================================================================
# CONFIGURAÇÕES DE RECONHECIMENTO DE FALA
# ===================================================================

# Idioma padrão
# Exemplos: pt-BR, en-US, es-ES, fr-FR
SPEECH_LANGUAGE=pt-BR

# Tempo máximo de espera em segundos
SPEECH_TIMEOUT=10

# ===================================================================
# CONFIGURAÇÕES DE IA
# ===================================================================

# Modelo a usar
# Opções: groq, openai
AI_MODEL=groq

# Criatividade da resposta (0.0 - 1.0)
# 0 = mais determinístico, 1 = mais criativo
AI_TEMPERATURE=0.7

# Comprimento máximo da resposta
AI_MAX_TOKENS=500

# Probabilidade cumulativa de tokens
# Valores menores = mais focado
AI_TOP_P=0.95

# ===================================================================
# CONFIGURAÇÕES DE SÍNTESE DE FALA
# ===================================================================

# Motor de síntese
# Opções: pyttsx3, google, openai
TTS_ENGINE=pyttsx3

# Idioma da síntese
TTS_LANGUAGE=pt-br

# Velocidade de fala (100-200, padrão 150)
TTS_RATE=150

# Volume de fala (0.0 - 1.0)
TTS_VOLUME=0.9

# Tipo de voz
# Opções: male, female
TTS_VOICE=female

# ===================================================================
# CONFIGURAÇÕES DO ASSISTENTE
# ===================================================================

# Nome do assistente
ASSISTANT_NAME=ARIA

# Personalidade
ASSISTANT_PERSONALITY=amigável, prestativo e inteligente

# Detectar automaticamente o idioma
AUTO_DETECT_LANGUAGE=true

# Comprimento máximo do histórico (mensagens anteriores)
MAX_CONTEXT_LENGTH=5

# ===================================================================
# CONFIGURAÇÕES DE DIRETÓRIOS
# ===================================================================

# Diretório de armazenamento de áudios
AUDIO_STORAGE_DIR=./audio_storage

# Diretório de logs
LOG_DIR=./logs

# ===================================================================
# CONFIGURAÇÕES DE LOGGING
# ===================================================================

# Nível de log
# Opções: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ===================================================================
# CONFIGURAÇÕES AVANÇADAS
# ===================================================================

# Modo debug (true/false)
DEBUG_MODE=false

# Salvar todas as conversas (true/false)
SAVE_CONVERSATIONS=true

# Habilitar análise de emoções (true/false)
ENABLE_EMOTION_DETECTION=true

# Número máximo de tentativas de reconhecimento
MAX_RECOGNITION_ATTEMPTS=3

# ===================================================================
# NOTAS IMPORTANTES
# ===================================================================
#
# 1. CHAVES DE API:
#    - Nunca compartilhe suas chaves publicamente
#    - Regenere chaves se comprometidas
#    - Use chaves diferentes para dev e produção
#
# 2. REQUISITOS DE SISTEMA:
#    - Python 3.8+
#    - Microfone funcionando
#    - Conexão com internet
#    - 500MB de espaço em disco
#
# 3. TROUBLESHOOTING:
#    - Se o microfone não funcionar: verifique permissões do SO
#    - Se não conectar à API: verifique a chave e conexão de rede
#    - Se houver erros de áudio: consulte os logs
#
# 4. PERFORMANCE:
#    - Reduzir AI_MAX_TOKENS aumenta velocidade
#    - TTS_RATE entre 100-200 é o ideal
#    - Use GROQ_API_KEY para respostas mais rápidas
#
